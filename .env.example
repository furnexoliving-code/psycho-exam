# Supabase — Dashboard -> Settings -> API
#
# Locally: copy this file to .env.local and fill it in.
# On Vercel: Project Settings -> Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ and never commit it —
# it bypasses row level security. Used solely to score attempts server-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (online payment for packages). Without these the packages page
# offers "Buy on WhatsApp" and the admin adds packages by hand.
# Dashboard -> Account & Settings -> API Keys; Webhooks -> secret you set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Search Console (Settings -> Ownership verification -> HTML tag):
# only the content="..." value of the meta tag.
GOOGLE_SITE_VERIFICATION=

# Cloudflare R2 (the pictures' copy, served through a Cloudflare domain
# so Supabase's egress is not paid for every picture a student loads).
# Server-only, never NEXT_PUBLIC_. R2 → Manage R2 API Tokens → a token
# with Object Read & Write on the one bucket: its Access Key ID, Secret
# Access Key and the endpoint it shows (https://<account>.r2.cloudflarestorage.com).
# Without these the pictures are uploaded to Supabase alone, as before.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kautilya-images

# The domain in front of the R2 bucket (R2 → the bucket → Settings →
# Custom Domains). Set it ONLY once Admin → Pictures shows every picture
# copied: from then on the portal serves the pictures from here. Unset it
# (and deploy) to serve from Supabase again.
NEXT_PUBLIC_IMAGE_HOST=
