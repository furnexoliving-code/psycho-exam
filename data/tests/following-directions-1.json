  "generalInstructions": [
    {
      "en": "This is a sample question paper. The number of questions and the time limit of each test will differ in the actual examination.",
      "hi": "यह केवल एक प्रतिदर्श प्रश्न पत्र है। वास्तविक परीक्षा में प्रत्येक परीक्षण में प्रश्नों की संख्या एवं समय-सीमा अलग होगी।"
    },
    {
      "en": "Before each test begins, the instructions for that test are shown on screen, covering the number of questions, the time limit and how to answer.",
      "hi": "प्रत्येक परीक्षण के प्रारंभ से पहले कंप्यूटर स्क्रीन पर उस परीक्षण से सम्बंधित निर्देश प्रदर्शित किए जायेंगे, जिनमें प्रश्नों की संख्या, समय-सीमा तथा प्रश्नों को हल करने की विधि समझाई जाएगी।"
    },
    {
      "en": "The test starts automatically as soon as the time allotted to the instruction screen is over.",
      "hi": "निर्देश स्क्रीन के बाद निर्धारित समय समाप्त होते ही परीक्षण स्वत: प्रारंभ हो जाएगा।"
    },
    {
      "en": "Click the desired option with the mouse to select your answer. Click another option to change it.",
      "hi": "उत्तर चयन करने के लिए माउस की सहायता से इच्छित विकल्प पर क्लिक करें। उत्तर बदलने के लिए किसी अन्य विकल्प पर क्लिक करें।"
    },
    {
      "en": "A question palette is shown in the upper left corner of each test, marking every question as Answered, Not Answered or Not Visited.",
      "hi": "प्रत्येक परीक्षण में स्क्रीन के ऊपरी बाएं कोने में एक प्रश्न पैलेट प्रदर्शित होगा, जिसमें प्रश्नों की स्थिति हल किये गए, हल नहीं किये गए अथवा अनदेखे के रूप में दर्शायी जाएगी।"
    },
    {
      "en": "A countdown timer in the upper right corner shows the time remaining in minutes and seconds. The test ends by itself when it reaches zero.",
      "hi": "स्क्रीन के ऊपरी दाहिने कोने में काउंटडाउन टाइमर शेष समय को मिनट और सेकंड में दिखाएगा। टाइमर शून्य पर पहुँचने पर परीक्षण स्वत: समाप्त हो जाएगा।"
    },
    {
      "en": "Keep an eye on the time limit. If a question seems difficult, move on rather than spending too long on it.",
      "hi": "समय सीमा का विशेष ध्यान रखें। यदि कोई प्रश्न कठिन लगे, तो उस पर अधिक समय न दें; अगले प्रश्नों को हल करें।"
    }
  ],
  "sections": [
    {
      "id": "following-directions",
      "kind": "following-directions",
      "name": {
        "en": "Following Directions",
        "hi": "निर्देश पालन"
      },
      "timeLimitMin": 6,
      "scored": true,
      "instructions": [
        {
          "en": "This is a test of your ability to follow directions accurately. A row of letters is shown, with the position of each letter numbered beneath it.",
          "hi": "यह निर्देशों का सही ढंग से पालन करने की क्षमता का परीक्षण है। अक्षरों की एक पंक्ति दिखाई जाती है, जिसके नीचे प्रत्येक अक्षर का स्थान अंकित होता है।"
        },
        {
          "en": "Each question gives a direction such as moving a number of places to the left or right of a letter, or counting from one end of the row.",
          "hi": "प्रत्येक प्रश्न में एक निर्देश दिया जाता है, जैसे किसी अक्षर से कुछ स्थान बाएँ या दाएँ जाना, अथवा पंक्ति के किसी छोर से गिनना।"
        },
        {
          "en": "Read the direction carefully, find the letter it leads to, and mark the option showing that letter.",
          "hi": "निर्देश को ध्यानपूर्वक पढ़ें, उससे प्राप्त अक्षर को खोजें, और उस अक्षर वाले विकल्प को चिह्नित करें।"
        },
        {
          "en": "Work quickly but carefully. A direction misread is a mark lost.",
          "hi": "तेज़ी से किंतु सावधानी से कार्य करें। गलत पढ़ा गया निर्देश अंक का नुकसान है।"
        }
      ],
      "example": {
        "text": [
          {
            "en": "For example, if the row is  K  M  T  B  R  and the question asks for the letter 2nd to the RIGHT of K, the answer is T, because moving two places right from K gives M then T.",
            "hi": "उदाहरण के लिए, यदि पंक्ति  K  M  T  B  R  है और प्रश्न K के दूसरे दाईं ओर के अक्षर के बारे में है, तो उत्तर T है, क्योंकि K से दो स्थान दाएँ जाने पर M फिर T आता है।"
          }
        ],
        "stimulus": {
          "type": "sequence",
          "items": [
            "K",
            "M",
            "T",
            "B",
            "R"
          ],
          "showPositions": true
        }
